# ---------------------------------------------------------------------------
# Copy to .env and edit. Every value below has a working default, so the
# system runs with no configuration at all (DEMO data mode).
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Default: local SQLite file, zero setup.
DATABASE_URL=sqlite:///./landslide.db
# PostgreSQL + PostGIS (used by docker-compose):
# DATABASE_URL=postgresql+psycopg://landslide:landslide@localhost:5432/landslide

# --- Weather data source ---------------------------------------------------
# false -> DEMO MODE: deterministic physically-modelled weather, no network.
# true  -> LIVE MODE: Open-Meteo public forecast API (no API key required).
USE_LIVE_WEATHER=false
WEATHER_PROVIDER=open-meteo
WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=8

# --- ML --------------------------------------------------------------------
MODEL_PATH=../ml/model.pkl

# --- Auth (DEMO credentials - replace before any real deployment) ----------
JWT_SECRET=change-me-in-production
JWT_EXPIRY_MINUTES=720
SEED_DEMO_USERS=true

# --- Early-warning thresholds ---------------------------------------------
ALERT_HIGH_THRESHOLD=60
ALERT_CRITICAL_THRESHOLD=80

# --- Server ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
