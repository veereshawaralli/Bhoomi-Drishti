  "data_provenance": {
    "data_mode": "DEMO",
    "feature_source": "SIMULATED - hourly weather process in ml/hydrology.py over the approximate terrain table in ml/data/regions_seed.py",
    "label_source": "SYNTHETIC - Bernoulli draws from the documented slope-stability model in ml/physics.py, plus 0.5% two-way observation noise",
    "real_world_validated": false,
    "notice": "Every metric here measures how well the model recovers ml/physics.py from noisy samples of it. None of them is evidence of real-world landslide forecast skill, and no prediction from this model should be presented as an observed or verified forecast.",
    "replace_with": "GSI National Landslide Susceptibility Mapping inventory for labels, IMD gridded rainfall for weather, Bhuvan/SRTM/Cartosat DEM for terrain; swap ml/data/generate_dataset.py for a loader and nothing downstream changes"
  },
  "intended_use": "Screening and triage of landslide hazard across monitored regions, and interactive what-if exploration. Decision support only.",
  "limitations": [
    "Trained on simulated data, so it reproduces a physical model rather than the observed landslide record.",
    "Hourly resolution and regional terrain averages - it cannot resolve an individual slope or a specific building.",
    "No earthquake, reservoir drawdown, blasting or excavation triggers are represented.",
    "Rainfall beyond the training range is clipped at the documented BOUNDS, so extreme what-if answers saturate rather than extrapolate.",
    "Decision support only: it does not replace inspection by a qualified geotechnical engineer."
  ],
